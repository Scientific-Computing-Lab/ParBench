# Large files & archives (exceed GitHub limits)
ParBench.zip
ParBench/downloads/

# Personal/temporary documents (not project deliverables)
*.docx
# PDFs are tracked — meeting transcripts & reference papers are project assets
# (conversation transcripts with research team are essential for progress tracking)
# HeCBench downloads (1.4 GB source tree — re-download via wget script)
downloads/
# XSBench source (regular clone, not submodule — commit pinned in spec provenance)
xsbench/xsbench-src/
# RSBench source (regular clone — commit pinned in spec provenance)
rsbench/rsbench-src/
# mixbench source (regular clone — commit pinned in spec provenance)
mixbench/mixbench-src/
# HeCBench source tree (1.4 GB — re-download via wget)
HeCBench-master/
# Evaluation result backups (large, not tracked)
results/evaluation_backup*/
# Local machine-specific config (generated from config/paths.json.template by setup script)
config/paths.json
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
env_parbench/
# IDE
.idea/
.vscode/
*.swp
*.swo
# Byte-compiled / temp
*.log
*.tmp
# Claude Code agent worktrees (temporary, auto-cleaned)
.claude/worktrees/
# Post-session validation sentinel (written by /validate, never committed)
.validation_passed
# Codex review sentinel (written by codex-review-reminder.sh hook, never committed)
.codex_review_done
# Machine-local paths (generated by setup_claude_for_sam.sh)
.claude/.local-paths
# User-local settings (generated from .claude/settings.local.json.template)
.claude/settings.local.json
# TikZ figure preview artifacts (local only, not for Overleaf)
docs/paper/NeurIPS_ready_version/figures/figures_tek_version/parbench_preamble.tex
docs/paper/NeurIPS_ready_version/figures/figures_tek_version/preview_*.tex
docs/paper/NeurIPS_ready_version/figures/figures_tek_version/out/
# Codex CLI local state (config lives at ~/.codex/config.toml)
.codex/
# File ownership tracking (session-ephemeral, written by file-ownership.sh hook)
.file-owners.json
# Build artifacts
*.o
*.out
# OD-1 ruling 2026-08-20: keep benchmark evidence dumps under results/ tracked (no more `git add -f`)
!results/**/*.out
*.a
*.so
*.d
.env

# ANL credentials — never commit
*.pem
*_key*
*_secret*
*credentials*


paper/

# Intentionally tracked despite the blanket paper/ rule above: the figure
# render+verify tool and its golden reference (so the workflow is reproducible
# for others). Everything else under docs/paper/ stays ignored.
!docs/paper/NeurIPS_ready_version/figures/figures_tek_version/render_figure.sh
!docs/paper/NeurIPS_ready_version/figures/figures_tek_version/references/f3_kernel_model_heatmap_unified.png
# Slice-3 (#27) manual edit-path note for the active number-carrying fragments.
!docs/paper/NeurIPS_ready_version/figures/figures_tek_version/FRAGMENT_EDIT_PATHS.md
# P0.4 translations bundle: 7 MB derivative of committed result JSONs,
# reproducible via scripts/rebuttal/export_translations.py (manifest is committed).
results/response_2026/translations/translations_bundle.zip

# Layer B evidence files (reverification_merged.jsonl, reverification_flagged_rerun.jsonl,
# target_baselines.json, source_baselines.json): formerly ignored here as rsync-synced dumps
# over/near GitHub's 100 MB limit. Since 2026-08-05 all four are git-lfs-tracked and committed
# (.gitattributes) because committed scripts read them; their ignore entries were removed.

# De-anonymized copies of the paper, kept locally for reference. Untracked but
# previously un-ignored, so a stray `git add -A` could have staged a full author
# block into a publicly mirrored repo during a double-blind window.
# Evidence: rebuttal/ARTIFACT_SCRUB_REPORT.md, section 0, Channel 3.
ParBench__A_Benchmark_for_Reliable_Evaluation_of_LLM_Parallel_Code_Translation.pdf
ParBench_arxiv_source_with_pdf_Gal.zip


# Scratch working directory
tmp/

# Codex review transcripts (local second-opinion output; see .claude/skills/codex-review)
.claude/codex-reviews/

# exec_blocks.py per-block run captures (regenerated every phase, never evidence of record)
scripts/rebuttal/block_runs/
.conveyor-logs/

# figure render workspace (previews + tmp builds; goldens in references/ ARE tracked)
docs/figures/figure_tooling/preview_output/
